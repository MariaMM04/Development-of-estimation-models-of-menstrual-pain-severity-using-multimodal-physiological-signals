   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import seaborn as sns  \n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "columns_to_study_lh = ['id', 'study_interval', 'lh', 'estrogen']\n",
    "df_h = pd.read_csv(r\"C:\\Users\\Maria\\TFG\\Missing values_per day\\hormones_nomissing.csv\", usecols=columns_to_study_lh)\n",
    "df_hormones= df_h[~df_h['study_interval'].isin([2024])]\n",
    "\n",
    "plt.figure(figsize=(30, 15))\n",
    "sns.boxplot(data=df_hormones, x='id', y='lh')\n",
    "    \n",
    "plt.title('LH Distribution by Participant ID', fontsize=30, pad=20, weight='bold')\n",
    "plt.xlabel('Participant ID', fontsize=26, labelpad=15)\n",
    "plt.ylabel('LH Value (mIU/mL)', fontsize=26, labelpad=15)\n",
    "plt.xticks(rotation=45, fontsize=20) \n",
    "plt.yticks(fontsize=20)\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(30, 15))\n",
    "sns.boxplot(data=df_hormones, x='id', y='estrogen')\n",
    "    \n",
    "plt.title('Estrogen Distribution by Participant ID', fontsize=30, pad=20, weight='bold')\n",
    "plt.xlabel('Participant ID', fontsize=26, labelpad=15)\n",
    "plt.ylabel('Estrogen Value (ng/mL)', fontsize=26, labelpad=15)\n",
    "plt.xticks(rotation=45, fontsize=20) \n",
    "plt.yticks(fontsize=20) \n",
    "plt.show()"
   ]
  },
