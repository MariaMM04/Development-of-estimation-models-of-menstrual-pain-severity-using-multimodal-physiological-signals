   "source": [
    "df = pd.read_csv(r\"C:\\Users\\Maria\\TFG\\Missing values_per day\\hormones_nomissing.csv\")\n",
    "df_filtered = df[~df['study_interval'].isin([2024])]\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.boxplot(data=df_filtered, x='phase', y='lh')\n",
    "\n",
    "plt.title('LH Levels Across Menstrual Phases')\n",
    "plt.xlabel('Menstrual Cycle Phase')\n",
    "plt.ylabel('LH (mUI/ml)')\n",
    "plt.xticks(rotation=45)\n",
    "\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.boxplot(data=df_filtered, x='phase', y='estrogen')\n",
    "\n",
    "plt.title('E3G Levels Across Menstrual Phases')\n",
    "plt.xlabel('Menstrual Cycle Phase')\n",
    "plt.ylabel('Estrogen (ng/mL)')\n",
    "plt.xticks(rotation=45)\n",
    "\n",
    "plt.show()"
   ]
  },
